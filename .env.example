# Copia este archivo como .env y rellena el token para activar el botón de
# "Reportar un error" (el archivo .env está ignorado por git).
#
# El token debe permitir Issues: Read and write y Contents: Read and write
# sobre el repositorio indicado. Con la CLI de GitHub: `gh auth token`.
GITHUB_ISSUES_TOKEN=
GITHUB_ISSUES_REPO=tavoibarra912/AppComunidadVecinos
GITHUB_ISSUES_LABEL=User-Detected-Issue
GITHUB_ISSUES_ATTACHMENTS_BRANCH=main

# Opcionales (GitHub Enterprise o pruebas locales)
# GITHUB_ISSUES_API_URL=https://api.github.com
# GITHUB_ISSUES_RAW_URL=https://raw.githubusercontent.com

# Base de datos de Prisma Postgres para el historial de reportes de error.
# Copia la cadena de conexión (postgres://...) desde la consola de Prisma
# (Connect to your database). Nunca se escribe en el código.
DATABASE_URL=

# Datos de demo locales (censo, cuotas y cuentas de prueba). Se siembran solo
# fuera de producción y sobre bases que no hayan arrancado en producción.
# APP_DEMO_DATA=false los desactiva también en local.
APP_DEMO_DATA=
